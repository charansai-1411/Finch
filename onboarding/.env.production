# Production build config for the onboarding app (Vite reads VITE_* at build time).
# These bake the DEPLOYED backend + widget endpoints into `npm run build`, so the
# hosted app talks to AWS instead of localhost. Override in Amplify env vars if the
# API URL changes (Amplify env vars take precedence over this file).

# The live Finch API (API Gateway HTTP API). Used by the Support agent flow.
VITE_FINCH_API=https://gsq790ciza.execute-api.ap-south-1.amazonaws.com

# The hosted Support widget (support.js on S3/CloudFront) used by the in-app
# "Test your agent" live preview.
VITE_FINCH_WIDGET=https://finch-widget-938358604976.s3.ap-south-1.amazonaws.com/support.js
